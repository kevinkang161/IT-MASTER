# IT MASTER - Environment Variables Example
# Duplicate this file to .env.local and fill in your values

# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (Do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform Mode (demo/live)
# When set to "demo" and Supabase credentials are empty or invalid, the platform gracefully uses embedded seed & mock data
NEXT_PUBLIC_PLATFORM_MODE=demo
